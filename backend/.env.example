# =====================================================
# PIRAX BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# =====================================================
# Copy this file to .env and fill in the required values.
# DO NOT commit the actual .env file or real secrets to git.
# =====================================================

# -----------------------------------------------------
# Application Configuration
# -----------------------------------------------------
# REQUIRED: Environment mode (development / production / test)
NODE_ENV=development

# REQUIRED: HTTP Port for NestJS backend server
PORT=3010

# REQUIRED: API Route Prefix
API_PREFIX=api/v1

# REQUIRED: Base Application URL
APP_URL=http://localhost:3010

# REQUIRED: Frontend URL (Used for CORS, AI callbacks, redirects)
FRONTEND_URL=http://localhost:5189

# OPTIONAL: Rate limiting configuration
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# -----------------------------------------------------
# Database Configuration (Neon PostgreSQL)
# -----------------------------------------------------
# REQUIRED: Full PostgreSQL Connection String (Primary for Neon)
DATABASE_URL=postgresql://user:password@ep-cool-host-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTIONAL: Connection parameters if DATABASE_URL is not used
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pirax_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------
# Authentication / JWT / Encryption
# -----------------------------------------------------
# REQUIRED: Secret key for signing Access Tokens (min 32 chars)
JWT_ACCESS_SECRET=your_jwt_access_secret_min32chars_change_me

# REQUIRED: Secret key for signing Refresh Tokens (min 32 chars)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min32chars_change_me

# REQUIRED: Expiration duration for Access Tokens (e.g., 15m, 1h)
JWT_ACCESS_EXPIRATION=15m

# REQUIRED: Expiration duration for Refresh Tokens (e.g., 7d, 30d)
JWT_REFRESH_EXPIRATION=7d

# REQUIRED: Encryption key for User BYOK API key storage (min 32 chars)
BYOK_ENCRYPTION_KEY=your_byok_encryption_key_min32chars_change_me

# OPTIONAL: OAuth Client IDs (Google / Apple)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.your-org.pirax

# -----------------------------------------------------
# OpenRouter / AI Pipeline (Primary AI Provider)
# -----------------------------------------------------
# REQUIRED: OpenRouter API key for LLM generation
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key

# OPTIONAL: OpenRouter API base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OPTIONAL: Default LLM model via OpenRouter
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# OPTIONAL: Vision model via OpenRouter
OPENROUTER_VISION_MODEL=google/gemini-pro-1.5

# OPTIONAL: Embedding model via OpenRouter
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# OPTIONAL: OpenAI Direct API fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# -----------------------------------------------------
# Qdrant Vector Database (RAG & Knowledge Retrieval)
# -----------------------------------------------------
# REQUIRED: Qdrant cluster / instance host
QDRANT_HOST=localhost

# REQUIRED: Qdrant port
QDRANT_PORT=6333

# OPTIONAL: Qdrant API key (Required for cloud / secured instances)
QDRANT_API_KEY=

# OPTIONAL: Prefix for Qdrant vector collections
QDRANT_COLLECTION_PREFIX=pirax

# -----------------------------------------------------
# Firebase Admin SDK (Push Notifications & Mobile Auth)
# -----------------------------------------------------
# REQUIRED (if Push Notifications enabled): Firebase Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# REQUIRED (if Push Notifications enabled): Firebase Service Account Private Key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# REQUIRED (if Push Notifications enabled): Firebase Service Account Client Email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# -----------------------------------------------------
# Razorpay Integration (Payments)
# -----------------------------------------------------
# REQUIRED (for Razorpay payments): Razorpay Key ID
RAZORPAY_KEY_ID=rzp_live_your_key_id

# REQUIRED (for Razorpay payments): Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OPTIONAL / PENDING: Razorpay Webhook Secret
# Note: Keep commented or empty until deployment webhook configuration is completed.
# RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------
# Tavily & Web Search Integration
# -----------------------------------------------------
# REQUIRED (for AI Deep Research feature): Tavily Web Search API Key
TAVILY_API_KEY=tvly-your-tavily-api-key

# OPTIONAL: Serper API Key (Secondary search provider fallback)
SERPER_API_KEY=

# -----------------------------------------------------
# E2B & Code Execution Sandbox
# -----------------------------------------------------
# OPTIONAL / ALTERNATIVE: Self-hosted Sandbox URL & Key
CODE_SANDBOX_URL=http://localhost:8080
CODE_SANDBOX_API_KEY=your-sandbox-api-key
CODE_SANDBOX_TIMEOUT=30000

# -----------------------------------------------------
# Email / Brevo SMTP Integration (Primary Email Transport)
# -----------------------------------------------------
# REQUIRED: Default sender email address
EMAIL_DEFAULT_FROM=noreply@pirax.com

# REQUIRED: Brevo SMTP Host
MAIL_HOST=smtp-relay.brevo.com

# REQUIRED: Brevo SMTP Port
MAIL_PORT=587

# REQUIRED: Brevo SMTP Login / Account Email
MAIL_USERNAME=your_brevo_smtp_login

# REQUIRED: Brevo SMTP Password / API Key
MAIL_PASSWORD=your_brevo_smtp_password_key

# -----------------------------------------------------
# OPTIONAL Services (Disabled or Safe to Skip)
# -----------------------------------------------------
# OPTIONAL: ClickHouse Analytics (Safe to skip - PostgreSQL handles fallback)
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=pirax_analytics
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# OPTIONAL: AWS SES (Replaced by Brevo SMTP - Safe to skip)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SES_CONFIGURATION_SET=

# OPTIONAL: Stripe Payments (Replaced by Razorpay - Safe to skip)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_MONTHLY=
# STRIPE_PRICE_ID_YEARLY=

# OPTIONAL: Cloudflare R2 / S3 Object Storage
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# -----------------------------------------------------
# CORS & WebSockets
# -----------------------------------------------------
# REQUIRED: Allowed origins for HTTP API & WebSocket Gateways (comma-separated)
CORS_ORIGINS=http://localhost:3010,http://localhost:5189,http://localhost:3000
